<%= react_component "Title" %>
<main>
  <section>
    <%= react_component "Subtitle", props: { text: "Projects" } %>
    <ol>
      <% @projects.each do |project| %>
        <li><%= project.name %></li>
      <% end %>
    </ol>
  </section>
  <section>
    <%= react_component "Subtitle", props: { text: "Todos" } %>
    <ol>
      <% @todos.each do |todo| %>
        <li><%= todo.name %></li>
      <% end %>
    </ol>
  </section>
</main>
